# Copy to .env (never commit .env). Without it the app runs in OFFLINE heuristic mode (not an LLM).
#
# --- Pick ONE provider block ------------------------------------------------------------
# OpenAI
# MODEL_PROVIDER=openai
# MODEL_NAME=gpt-4.1-mini
# MODEL_API_KEY=sk-...
#
# Google Gemini (native API; works with AI Studio keys starting "AQ." and legacy "AIza")
# MODEL_PROVIDER=gemini
# MODEL_NAME=gemini-2.5-flash        # use a name listed for your key in AI Studio
# MODEL_API_KEY=...
#
# Groq / OpenRouter / Together / DeepSeek / Mistral (OpenAI-compatible)
# MODEL_PROVIDER=openai
# MODEL_COMPAT=generic
# MODEL_BASE_URL=https://api.groq.com/openai/v1
# MODEL_NAME=llama-3.3-70b-versatile
# MODEL_API_KEY=...
#
# Local Ollama (no key; from Docker use host.docker.internal)
# MODEL_PROVIDER=openai
# MODEL_COMPAT=generic
# MODEL_BASE_URL=http://host.docker.internal:11434/v1
# MODEL_NAME=qwen2.5:14b
#
# Model names above are examples: use one your account can access and that supports tool calling.
MODEL_PROVIDER=offline

# --- Optional tuning (defaults shown; hard policy is not configurable) ------------------------
# MODEL_TEMPERATURE=
# MODEL_TIMEOUT_SECONDS=30
# TURN_TIMEOUT_SECONDS=60
# MAX_MODEL_CALLS_PER_TURN=3
# MAX_TOOL_CALLS_PER_TURN=3
# MAX_OUTPUT_TOKENS=1024
# MODEL_CONCURRENCY=4
# HISTORY_MESSAGES=8
# MAX_MESSAGE_CHARS=8000
# MAX_NOTE_CHARS=2000
# MAX_REASON_CHARS=500
# LOG_LEVEL=INFO
# DATABASE_PATH=data/assistant.sqlite3      # container default: /data/assistant.sqlite3
